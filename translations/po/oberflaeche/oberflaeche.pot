#. EN: Falling back asleep
msgctxt "ui:weckenBegleitungTitel#text"
msgid "Wiedereinschlafen"
msgstr ""

#. Text der Oberfläche
#. EN: Briefly note your dream in a few words, then let yourself be guided calmly back to sleep.
msgctxt "ui:weckenBegleitungEinleitung#text"
msgid "Halte deinen Traum kurz in Stichworten fest und lass dich danach ruhig zurück in den Schlaf begleiten."
msgstr ""

