msgstr ""

#. Text der Oberfläche
#. EN: Asks before playing if no headphones are connected.
msgctxt "ui:lautsprecherEinstellungFrageText#text"
msgid "Fragt vor dem Abspielen, wenn keine Kopfhörer angeschlossen sind."
msgstr ""

#. Text der Oberfläche
#. EN: Pause when headphones are disconnected
msgctxt "ui:lautsprecherEinstellungPauseTitel#text"
msgid "Pausieren, wenn Kopfhörer getrennt werden"
msgstr ""

#. Text der Oberfläche
#. EN: Pauses playback as soon as wired or Bluetooth headphones are disconnected.
msgctxt "ui:lautsprecherEinstellungPauseText#text"
msgid "Hält die Wiedergabe an, sobald Kabel- oder Bluetooth-Kopfhörer getrennt werden."
msgstr ""

#. Text der Oberfläche
#. EN: On
msgctxt "ui:realitaetStatusEin#text"
msgid "Ein"
msgstr ""

#. Text der Oberfläche
#. EN: Off
msgctxt "ui:realitaetStatusAus#text"
msgid "Aus"
msgstr ""

#. Text der Oberfläche
#. EN: Say an anonymous hello once
msgctxt "ui:halloTitel#text"
msgid "Einmal anonym Hallo sagen"
msgstr ""

#. Text der Oberfläche
#. EN: Voluntary: If you like, you can say hello to us once. Only the app version and language are transmitted – encrypted and without a sender.
msgctxt "ui:halloErklaerung#text"
msgid "Freiwillig: Wenn du magst, sagst du uns einmal Hallo. Übertragen werden ausschließlich Version und Sprache der App – verschlüsselt und ohne Absender."
msgstr ""

#. Text der Oberfläche
#. EN: Say hello
msgctxt "ui:halloKnopf#text"
msgid "Hallo sagen"
msgstr ""

#. Platzhalter unverändert übernehmen: {datum}
#. EN: Thank you, sent on {datum}.
msgctxt "ui:halloDankeGesendet#text"
msgid "Danke, gesendet am {datum}."
msgstr ""

#. Text der Oberfläche
#. EN: Thank you for saying hello!
msgctxt "ui:halloGesendet#text"
msgid "Danke für dein Hallo!"
msgstr ""

#. Text der Oberfläche
#. EN: Compare sleep data
msgctxt "ui:schlafTitel#text"
msgid "Schlafdaten abgleichen"
msgstr ""

#. Text der Oberfläche
#. EN: A look back at your night
msgctxt "ui:schlafEinladung#text"
msgid "Deine Nacht im Rückblick"
msgstr ""

#. Text der Oberfläche
#. EN: Optional: View sleep data already synced to Health Connect alongside your own observations. No live detection or signals during the night. Dream Practice works without a device.
msgctxt "ui:schlafErklaerung#text"
msgid "Optional: Bereits synchronisierte Schlafdaten aus Health Connect neben deinen eigenen Beobachtungen ansehen. Keine Live-Erkennung, keine Signale während der Nacht. Die Traumpraxis funktioniert auch ohne Gerät."
msgstr ""

#. Text der Oberfläche
#. EN: VelvetPulse reads only sleep sessions from the last 30 days when you explicitly start a comparison. It writes nothing to Health Connect. Imported copies stay local and are included in your backup; nothing is shared with the coach or your partner.
msgctxt "ui:schlafDatenschutz#text"
msgid "VelvetPulse liest nur Schlafsitzungen der letzten 30 Tage, wenn du den Abgleich ausdrücklich startest. Es schreibt nichts nach Health Connect. Importierte Kopien bleiben lokal und werden in deine Sicherung aufgenommen; keine Weitergabe an Coach oder Paarraum."
msgstr ""

#. Text der Oberfläche
#. EN: Enable sharing of sleep data from Fitbit or Google Health to Health Connect. Only data actually available there can be shown. Sleep stages are estimates, not a diagnosis.
msgctxt "ui:schlafHinweis#text"
msgid "Aktiviere die Freigabe deiner Schlafdaten in Fitbit bzw. Google Health für Health Connect. Es werden nur Daten angezeigt, die dort tatsächlich verfügbar sind. Schlafphasen sind Schätzungen, keine Diagnose."
msgstr ""

#. Text der Oberfläche
#. EN: Connect Health Connect
msgctxt "ui:schlafVerbinden#text"
msgid "Health Connect verbinden"
msgstr ""

#. Text der Oberfläche
#. EN: Compare last 30 days
msgctxt "ui:schlafImportieren#text"
msgid "Letzte 30 Tage abgleichen"
msgstr ""

#. Text der Oberfläche
#. EN: Import selected source
msgctxt "ui:schlafUebernehmen#text"
msgid "Ausgewählte Quelle übernehmen"
msgstr ""

#. Text der Oberfläche
#. EN: Data source
msgctxt "ui:schlafQuelle#text"
msgid "Datenquelle"
msgstr ""

#. Text der Oberfläche
#. EN: Choose a source. Records from different devices are not added together.
msgctxt "ui:schlafQuelleWaehlen#text"
msgid "Bitte wähle eine Quelle. Aufzeichnungen verschiedener Geräte werden nicht addiert."
msgstr ""

#. Text der Oberfläche
#. EN: Turn off comparison
msgctxt "ui:schlafTrennen#text"
msgid "Abgleich ausschalten"
msgstr ""

#. Text der Oberfläche
#. EN: Comparison is off. Imported data is retained. You can revoke the Android permission in Health Connect.
msgctxt "ui:schlafGetrennt#text"
msgid "Abgleich ausgeschaltet. Importierte Daten bleiben erhalten. Die Android-Berechtigung kannst du in Health Connect widerrufen."
msgstr ""

#. Text der Oberfläche
#. EN: Comparison is enabled. Data is read only when you request it.
msgctxt "ui:schlafVerbunden#text"
msgid "Abgleich aktiviert. Daten werden nur auf deinen Wunsch gelesen."
msgstr ""

#. Text der Oberfläche
#. EN: Access to sleep data is missing. You can allow it in Health Connect; the rest of Dream Practice stays available.
msgctxt "ui:schlafBerechtigungFehlt#text"
msgid "Zugriff auf Schlafdaten fehlt. Du kannst ihn in Health Connect erlauben; die übrige Traumpraxis bleibt nutzbar."
msgstr ""

#. Text der Oberfläche
#. EN: This optional import needs Android 14 or later and available Health Connect. All other exercises remain available.
msgctxt "ui:schlafNichtVerfuegbar#text"
