#. EN: Alone
msgctxt "ui:kursBildAllein#text"
msgid "Allein"
msgstr ""

#. Text der Oberfläche
#. EN: Together
msgctxt "ui:kursBildZuZweit#text"
msgid "Zu zweit"
msgstr ""

#. Text der Oberfläche
#. EN: There are new episodes and pictures for this series. Best to update on Wi-Fi. Afterwards everything works offline again.
msgctxt "ui:reihePaketNeu#text"
msgid "Es gibt neue Folgen und Bilder für diese Reihe. Am besten im WLAN aktualisieren. Danach läuft alles wieder ohne Netz."
msgstr ""

#. Text der Oberfläche
#. EN: Download failed. Please try again later.
msgctxt "ui:reiheLadenFehler#text"
msgid "Laden hat nicht geklappt. Bitte später noch einmal versuchen."
msgstr ""

#. Text der Oberfläche
#. EN: Available offline
msgctxt "ui:reiheOffline#text"
msgid "Offline verfügbar"
msgstr ""

#. Text der Oberfläche
