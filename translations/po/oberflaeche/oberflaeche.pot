msgctxt "ui:reiheKeineAufnahme#text"
msgid "Zu dieser Fassung gibt es noch keine Aufnahme; die Geräte-Stimme liest vor."
msgstr ""

#. Text der Oberfläche
#. EN: Speaker
msgctxt "ui:lautsprecherFrageTitel#text"
msgid "Lautsprecher"
msgstr ""

#. Text der Oberfläche
#. EN: Playback will play through the speaker. Play anyway?
msgctxt "ui:lautsprecherFrageNachricht#text"
msgid "Die Wiedergabe läuft über den Lautsprecher. Trotzdem abspielen?"
msgstr ""

#. Text der Oberfläche
#. EN: Play
msgctxt "ui:lautsprecherAbspielen#text"
