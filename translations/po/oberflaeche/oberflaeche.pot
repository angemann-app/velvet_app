msgid "Heute nicht"
msgstr ""

#. Text der Oberfläche
#. EN: All good. The step will wait, and nothing expires.
msgctxt "ui:ersteWocheHeuteNichtAntwort#text"
msgid "Alles gut. Der Schritt wartet, ohne dass etwas verfällt."
msgstr ""

#. Text der Oberfläche
