[
  {
    "seite": 1,
    "text": "EINE MARKE FÜR EIGENES ERLEBEN",
    "x": 60,
    "y": 46,
    "w": 840,
    "h": 12.100000000000001
  },
  {
    "seite": 1,
    "text": "Dein Körper.Dein Erleben.",
    "x": 60,
    "y": 300,
    "w": 490,
    "h": 119.77999999999999
  },
  {
    "seite": 1,
    "text": "Verstehen. Spüren. Verbinden.",
    "x": 64,
    "y": 460,
    "w": 450,
    "h": 25.2
  },
  {
    "seite": 1,
    "text": "Markensystem, Gestaltung und Anwendung.Papier. Graphit. Rosé.",
    "x": 64,
    "y": 545,
    "w": 420,
    "h": 36.4
  },
  {
    "seite": 2,
    "text": "01 / HALTUNG UND POSITIONIERUNG",
    "x": 60,
    "y": 46,
    "w": 840,
    "h": 12.100000000000001
  },
  {
    "seite": 2,
    "text": "Ein persönlicher Raum.Kein vorgegebenes Erlebnis.",
    "x": 60,
    "y": 90,
    "w": 840,
    "h": 85.88
  },
  {
    "seite": 2,
    "text": "Was VelvetPulse ist",
    "x": 60,
    "y": 220,
    "w": 385,
    "h": 26.45
  },
  {
    "seite": 2,
    "text": "Ein persönlicher Raum für Körperwissen, Wahrnehmung, Berührung und Nähe. Ein digitales Magazin, das zum eigenen Erleben einlädt.",
    "x": 60,
    "y": 258.45,
    "w": 385,
    "h": 63.0
  },
  {
    "seite": 2,
    "text": "Für wen",
    "x": 60,
    "y": 348.45,
    "w": 385,
    "h": 26.45
  },
  {
    "seite": 2,
    "text": "Für Erwachsene, die ihren Körper besser verstehen, sich selbst bewusster wahrnehmen oder Nähe gestalten möchten. Allein und zu zweit. Unterschiedliche Körper, Beziehungen und Lebensphasen sind willkommen.",
    "x": 60,
    "y": 386.9,
    "w": 385,
    "h": 84.0
  },
  {
    "seite": 2,
    "text": "Was die Marke vermittelt",
    "x": 515,
    "y": 220,
    "w": 385,
    "h": 26.45
  },
  {
    "seite": 2,
    "text": "Wärme und Diskretion schaffen einen ruhigen Einstieg. Wissen gibt Orientierung. Sinnlichkeit macht neugierig. Die eigene Erfahrung bleibt frei.",
    "x": 515,
    "y": 258.45,
    "w": 385,
    "h": 63.0
  },
  {
    "seite": 2,
    "text": "Was wir nicht versprechen",
    "x": 515,
    "y": 348.45,
    "w": 385,
    "h": 26.45
  },
  {
    "seite": 2,
    "text": "Keine garantierten Orgasmen, Heilung oder automatische Veränderung der Lust. Keine Körpernorm als Ziel. Möglichkeiten werden konkret beschrieben, Ergebnisse bleiben individuell.",
    "x": 515,
    "y": 386.9,
    "w": 385,
    "h": 84.0
  },
  {
    "seite": 3,
    "text": "02 / DAS PRÄGNANTERE MARKENZEICHEN",
    "x": 60,
    "y": 46,
    "w": 840,
    "h": 12.100000000000001
  },
  {
    "seite": 3,
    "text": "Ein Bogen. Eine Bewegung. Ein V.",
    "x": 60,
    "y": 90,
    "w": 840,
    "h": 42.94
  },
  {
    "seite": 3,
    "text": "Offener Bogen",
    "x": 60,
    "y": 440,
    "w": 385,
    "h": 26.45
  },
  {
    "seite": 3,
    "text": "Ein Raum, der nicht abschließt. Der kleine Rosé-Akzent verbindet Wärme mit der graphitfarbenen Kontur.",
    "x": 60,
    "y": 478.45,
    "w": 385,
    "h": 42.0
  },
  {
    "seite": 3,
    "text": "Weiche V-/Pulslinie",
    "x": 515,
    "y": 440,
    "w": 385,
    "h": 26.45
  },
  {
    "seite": 3,
    "text": "Eine klare eigene Bewegung statt Herz, Flamme oder medizinischer Kurve. Weniger Striche und kräftigere Konturen halten das Zeichen auch klein zusammen.",
    "x": 515,
    "y": 478.45,
    "w": 385,
    "h": 63.0
  },
  {
    "seite": 4,
    "text": "03 / DIE LOGO-FAMILIE",
    "x": 60,
    "y": 46,
    "w": 840,
    "h": 12.100000000000001
  },
  {
    "seite": 4,
    "text": "Eine Form. Viele sinnvolle Anwendungen.",
    "x": 60,
    "y": 90,
    "w": 840,
    "h": 42.94
  },
  {
    "seite": 4,
    "text": "Horizontal als Standard. Gestapelt bei wenig Breite. Signet für App und Avatar. Einfarbig dunkel oder weiß für reduzierte Anwendungen.",
    "x": 420,
    "y": 497,
    "w": 455,
    "h": 42.0
  },
  {
    "seite": 5,
    "text": "04 / SCHUTZRAUM UND KLEINFORMATE",
    "x": 60,
    "y": 46,
    "w": 840,
    "h": 12.100000000000001
  },
  {
    "seite": 5,
    "text": "Erkennbar statt dekorativ.",
    "x": 60,
    "y": 90,
    "w": 840,
    "h": 42.94
  },
  {
    "seite": 5,
    "text": "Mindestens ein Viertel der sichtbaren Signethöhe bleibt ringsum frei. Diese Luft gehört zum Logo.",
    "x": 60,
    "y": 438,
    "w": 360,
    "h": 44.8
  },
  {
    "seite": 5,
    "text": "Mindestgrößen",
    "x": 515,
    "y": 200,
    "w": 385,
    "h": 26.45
  },
  {
    "seite": 5,
    "text": "Horizontale Kombination: 160 Pixel oder 35 Millimeter Breite. Signet: ab 24 Pixeln. Für 16 bis 23 Pixel nur die kräftigere einfarbige Kompaktfassung.",
    "x": 515,
    "y": 238.45,
    "w": 385,
    "h": 63.0
  },
  {
    "seite": 5,
    "text": "Unverändert verwenden",
    "x": 515,
    "y": 328.45,
    "w": 385,
    "h": 26.45
  },
  {
    "seite": 5,
    "text": "Nicht stauchen, drehen, schraffieren oder mit Schatten versehen. Kein Text im offenen Bogen. Keine zusätzliche Umrandung oder Verlaufsfüllung.",
    "x": 515,
    "y": 366.9,
    "w": 385,
    "h": 63.0
  },
  {
    "seite": 5,
    "text": "Varianten bewusst wählen",
    "x": 515,
    "y": 456.9,
    "w": 385,
    "h": 26.45
  },
  {
    "seite": 5,
    "text": "Helle Logos brauchen dunklen Grund. Die Wortmarke bleibt in den gelieferten Pfaden unverändert; sie ist unabhängig von installierten Schriften.",
    "x": 515,
    "y": 495.34999999999997,
    "w": 385,
    "h": 63.0
  },
